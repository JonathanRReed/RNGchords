---
import InfoPage from "../layouts/InfoPage.astro";

const title = "Contact RNG Chords | Jonathan R. Reed Music Tool";
const description =
	"Contact Jonathan R. Reed about RNG Chords, the free browser-based chord progression generator for songwriting and MIDI sketching.";
const published = "2026-04-21";
const structuredData = {
	"@context": "https://schema.org",
	"@type": "ContactPage",
	name: "Contact RNG Chords",
	description,
	url: new URL("/contact/", Astro.site ?? "https://rngchords.jonathanrreed.com").toString(),
	datePublished: published,
	dateModified: "2026-08-04",
	author: {
		"@type": "Person",
		name: "Jonathan R. Reed",
		url: "https://jonathanrreed.com",
	},
};
---

<InfoPage
	title={title}
	description={description}
	path="/contact/"
	heading="Contact"
	jsonLd={[structuredData]}
	dateLabel="Published"
	date={published}
>
	<p>
		Feedback, bug reports, accessibility problems, and feature ideas all go
		through my main contact page.
	</p>
	<p>
		If something broke, tell me the browser, whether playback ever started,
		which sound you had selected, and what you were doing when it failed:
		rolling, keeping chords, copying text, or exporting MIDI. If a progression
		just sounds bad, that's a different report. Include the mode, key, tempo,
		and any chords you had kept.
	</p>
	<p>
		For feature ideas, describe the musical problem instead of naming a
		control. "I need more borrowed chords in minor keys" tells me more than a
		request for more randomness.
	</p>
	<p>
		<a class="button" href="https://jonathanrreed.com/contact/">Open my contact page</a>
	</p>
</InfoPage>
