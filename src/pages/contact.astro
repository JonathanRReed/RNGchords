---
import InfoPage from "../layouts/InfoPage.astro";

const title = "Contact RNG Chords | Jonathan R. Reed Music Tool";
const description =
	"Contact Jonathan R. Reed about RNG Chords, the free chord progression generator that uses dice.";
const published = "2026-04-21";
const structuredData = {
	"@context": "https://schema.org",
	"@type": "ContactPage",
	name: "Contact RNG Chords",
	description,
	url: new URL("/contact/", Astro.site ?? "https://rngchords.jonathanrreed.com").toString(),
	datePublished: published,
	dateModified: "2026-08-04",
	author: {
		"@type": "Person",
		name: "Jonathan R. Reed",
		url: "https://jonathanrreed.com",
	},
};
---

<InfoPage
	title={title}
	description={description}
	path="/contact/"
	heading="Contact"
	jsonLd={[structuredData]}
	dateLabel="Published"
	date={published}
>
	<p>
		Feedback, bug reports, accessibility problems, and feature ideas all go
		through my main contact page. For a bug, include your browser, the sound
		you had selected, and what you were doing. For a feature idea, describe the
		musical problem rather than a control.
	</p>
	<p>
		<a class="button" href="https://jonathanrreed.com/contact/">Open my contact page</a>
	</p>
</InfoPage>
