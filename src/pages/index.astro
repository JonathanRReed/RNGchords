---
import RngChordsApp from "../components/RngChordsApp";
import "../styles/global.css";
import "../styles/tactile.css";

const pageTitle =
	"RNG Chords | Random Chord Generator";
const pageDescription =
	"Generate chord progressions for guitar, piano, songwriting, and production. Roll ideas, hear them instantly, keep the best chords, and export MIDI.";
const pageUrl = Astro.site
	? new URL("/", Astro.site).toString()
	: "https://rngchords.jonathanrreed.com/";
const socialImage = Astro.site
	? new URL("/social-card.svg", Astro.site).toString()
	: "/social-card.svg";
const authorSameAs = [
	"https://jonathanrreed.com/",
	"https://github.com/JonathanRReed",
	"https://helloworldfirm.com/",
];

// Site-level JSON-LD describes the public tool without inventing independent
// ratings or reviews that do not exist.
const structuredData = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"@id": `${pageUrl}#website`,
	name: "RNG Chords",
	description: pageDescription,
	url: pageUrl,
	image: socialImage,
	isAccessibleForFree: true,
	inLanguage: "en-US",
	datePublished: "2026-04-21",
	dateModified: "2026-07-16",
	author: {
		"@type": "Person",
		name: "Jonathan R. Reed",
		url: "https://jonathanrreed.com",
		sameAs: authorSameAs,
	},
	creator: {
		"@type": "Person",
		name: "Jonathan R. Reed",
		url: "https://jonathanrreed.com",
		sameAs: authorSameAs,
	},
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<script is:inline>try{var t=JSON.parse(localStorage.getItem("rng-chords-creative-session")||"{}").tableTheme;if(t)document.documentElement.setAttribute("data-theme",t);}catch(e){}</script>
		<link rel="icon" href="/favicon.ico" sizes="any">
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-180x180.png">
		<link rel="manifest" href="/site.webmanifest">
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0b0706" />
		<meta name="description" content={pageDescription} />
		<meta name="author" content="Jonathan R. Reed" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:image" content={socialImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={socialImage} />
		<link rel="canonical" href={pageUrl} />
		<meta property="og:url" content={pageUrl} />
		<link
			rel="preload"
			as="image"
			href="https://img.jonathanrreed.com/personal/jonathan.avif"
			type="image/avif"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{pageTitle}</title>
		<script
			is:inline
			type="application/ld+json"
			set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
		/>
	</head>
	<body>
		<RngChordsApp client:load />

		<footer class="site-footer reveal" style="animation-delay: 380ms;">
			<div class="site-footer__inner">
				<img
					src="https://img.jonathanrreed.com/personal/jonathan.avif"
					alt="Jonathan R. Reed"
					width="64"
					height="64"
					class="site-footer__avatar"
					loading="eager"
					decoding="async"
				/>
				<div class="site-footer__text">
					<p>
						<strong translate="no">RNG Chords</strong> is a simple chord
						generator by Jonathan R. Reed.
					</p>
					<nav class="site-footer__links" aria-label="RNG Chords site links">
						<a href="/about/">About</a>
						<a href="/contact/">Contact</a>
						<a href="/privacy/">Privacy</a>
						<a href="/subprocessors/">Subprocessors</a>
					</nav>
				</div>
			</div>
		</footer>
	</body>
</html>
