---
import RngChordsApp from "../app/RngChordsApp";
import SiteFooter from "../components/SiteFooter.astro";
import Base from "../layouts/Base.astro";
import "../styles/app.css";
import "../styles/table.css";

const pageTitle = "RNG Chords | Random Chord Generator";
const pageDescription =
	"Roll dice to get a chord progression. Keep the chords you like, reroll the rest, and download the result as a MIDI file. Free, no account.";
const pageUrl = Astro.site
	? new URL("/", Astro.site).toString()
	: "https://rngchords.jonathanrreed.com/";
const socialImage = Astro.site
	? new URL("/social-card.svg", Astro.site).toString()
	: "/social-card.svg";
const authorSameAs = [
	"https://jonathanrreed.com/",
	"https://github.com/JonathanRReed",
];
const publishedDate = "2026-04-21";
const modifiedDate = "2026-10-22";
const author = {
	"@type": "Person",
	name: "Jonathan R. Reed",
	url: "https://jonathanrreed.com",
	sameAs: authorSameAs,
};

// Site-level JSON-LD describes the public tool without inventing independent
// ratings or reviews that do not exist.
const structuredData = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"@id": `${pageUrl}#website`,
	name: "RNG Chords",
	description: pageDescription,
	url: pageUrl,
	image: socialImage,
	isAccessibleForFree: true,
	inLanguage: "en-US",
	datePublished: publishedDate,
	dateModified: modifiedDate,
	author,
	creator: author,
};

// Project-level JSON-LD. The tool has no independent ratings or reviews, so it
// deliberately avoids the SoftwareApplication rich-result type.
const creativeWorkData = {
	"@context": "https://schema.org",
	"@type": "CreativeWork",
	"@id": `${pageUrl}#project`,
	name: "RNG Chords",
	description: pageDescription,
	url: pageUrl,
	image: socialImage,
	isAccessibleForFree: true,
	inLanguage: "en-US",
	datePublished: publishedDate,
	dateModified: modifiedDate,
	isPartOf: { "@id": `${pageUrl}#website` },
	keywords: "random chord generator, chord progression generator, dice, MIDI export",
	author,
	creator: author,
};
---

<Base title={pageTitle} description={pageDescription} path="/" jsonLd={[structuredData, creativeWorkData]} author>
	<RngChordsApp client:load />

	<SiteFooter />
</Base>
