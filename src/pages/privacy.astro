---
import InfoPage from "../layouts/InfoPage.astro";

const title = "RNG Chords Privacy Policy | Local Music Tool";
const description =
	"RNG Chords runs in your browser and does not require accounts, analytics, tracking pixels, or server-side storage for generated chord ideas.";
const published = "2026-04-21";
const modified = "2026-06-19";
const structuredData = {
	"@context": "https://schema.org",
	"@type": "PrivacyPolicy",
	name: "RNG Chords Privacy Policy",
	description,
	url: new URL("/privacy/", Astro.site ?? "https://rngchords.jonathanrreed.com").toString(),
	datePublished: published,
	dateModified: modified,
	author: {
		"@type": "Person",
		name: "Jonathan R. Reed",
		url: "https://jonathanrreed.com",
	},
};
---

<InfoPage
	title={title}
	description={description}
	path="/privacy/"
	heading="Privacy"
	jsonLd={[structuredData]}
	dateLabel="Last updated"
	date={modified}
>
	<p>
		RNG Chords runs in your browser. It has no accounts, asks for no personal
		information, and never sends your chord ideas to a database.
	</p>
	<p>
		The site is hosted on Cloudflare Pages. Cloudflare may process routine
		request data such as your IP address, user agent, and request time to
		deliver and protect the site. The <a href="/subprocessors/">subprocessor
		disclosure</a> has the details. RNG Chords adds no analytics, tracking
		pixels, advertising scripts, or newsletter signups.
	</p>
	<p>
		Your last idea, saved versions, and settings (including your appearance
		choices) are kept in your browser's local storage so they're there when you
		come back. That data stays on your device. Clearing your browser data
		removes it, and there is no cloud copy to recover it from. If a progression
		matters, export the MIDI before you close the page.
	</p>
	<p>
		Audio is generated in the page by your browser. The site doesn't use your
		microphone, record anything, or look at other music software.
	</p>
	<p>
		If you follow a link to another site, such as my main contact page, that
		site has its own privacy practices. Any MIDI file or note you save belongs
		to the device and software you chose to save it in.
	</p>
</InfoPage>
