---
import "../styles/global.css";
import "../styles/tactile.css";

const pageTitle = "About RNG Chords | Jonathan R. Reed";
const pageDescription =
	"RNG Chords is a free browser-based chord progression generator by Jonathan R. Reed for songwriting, guitar, piano, and MIDI idea sketching.";
const pageUrl = Astro.site ? new URL("/about/", Astro.site).toString() : undefined;
const socialImage = Astro.site
	? new URL("/social-card.svg", Astro.site).toString()
	: "/social-card.svg";
const publishedDate = "2026-04-21";
const modifiedDate = "2026-08-04";
const structuredData = {
	"@context": "https://schema.org",
	"@type": "AboutPage",
	name: "About RNG Chords",
	description: pageDescription,
	...(pageUrl ? { url: pageUrl } : {}),
	datePublished: publishedDate,
	dateModified: modifiedDate,
	author: {
		"@type": "Person",
		name: "Jonathan R. Reed",
		url: "https://jonathanrreed.com",
	},
	mainEntity: {
		"@type": "WebSite",
		"@id": "https://rngchords.jonathanrreed.com/#website",
		name: "RNG Chords",
		description: pageDescription,
		isAccessibleForFree: true,
		url: "https://rngchords.jonathanrreed.com/",
		creator: {
			"@type": "Person",
			name: "Jonathan R. Reed",
			url: "https://jonathanrreed.com",
		},
	},
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<script is:inline>try{var t=JSON.parse(localStorage.getItem("rng-chords-creative-session")||"{}").tableTheme;if(t)document.documentElement.setAttribute("data-theme",t);}catch(e){}</script>
		<link rel="icon" href="/favicon.ico" sizes="any">
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-180x180.png">
		<link rel="manifest" href="/site.webmanifest">
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0b0706" />
		<meta name="description" content={pageDescription} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:image" content={socialImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={socialImage} />
		{pageUrl ? <link rel="canonical" href={pageUrl} /> : null}
		{pageUrl ? <meta property="og:url" content={pageUrl} /> : null}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{pageTitle}</title>
		<script
			is:inline
			type="application/ld+json"
			set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
		/>
	</head>
	<body>
		<main class="info-page">
			<a class="info-page__back" href="/">RNG Chords</a>
			<nav class="sr-only" aria-label="RNG Chords utility pages">
				<a href="/">RNG Chords generator</a>
				<a href="/contact/">Contact RNG Chords</a>
				<a href="/privacy/">RNG Chords privacy policy</a>
			</nav>
			<section class="info-page__panel panel-surface">
				<p class="panel-title__eyebrow">About</p>
				<h1>Random chord ideas for writing and practice.</h1>
				<p>
					RNG Chords is a free chord progression generator that runs in the
					browser. I built it for guitarists, pianists, songwriters, and
					producers who want a progression sitting in front of them before they
					have any plan for it.
				</p>
				<p>
					Most of the difficulty in starting is having nothing to react to. A
					random roll fixes that. Some rolls are wrong in a way that still helps,
					because hearing a chord you would never have written usually tells you
					what you actually wanted in that slot. Taste is still your job. This
					just gets you to the part where you have opinions.
				</p>
				<p>
					It works as a practice prompt too. Reroll until you land in a key you
					don't play in often, try the progression by ear, transpose it yourself,
					or send the MIDI into a DAW or notation software and read it back.
				</p>
				<p>
					The scope stays small on purpose, which is why it stays a single tab you
					can open between other work. Export a progression before you close it if
					the roll mattered.
				</p>
				<p class="info-page__meta">
					Published <time datetime={publishedDate}>April 21, 2026</time>.
				</p>
			</section>
		</main>
	</body>
</html>
