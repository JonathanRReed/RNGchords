---
import InfoPage from "../layouts/InfoPage.astro";

const title = "About RNG Chords | Jonathan R. Reed";
const description =
	"RNG Chords is a free chord progression generator by Jonathan R. Reed. Dice pick the chords, and you decide which ones stay.";
const published = "2026-04-21";
const modified = "2026-08-04";
const author = {
	"@type": "Person",
	name: "Jonathan R. Reed",
	url: "https://jonathanrreed.com",
};
const structuredData = {
	"@context": "https://schema.org",
	"@type": "AboutPage",
	name: "About RNG Chords",
	description,
	url: new URL("/about/", Astro.site ?? "https://rngchords.jonathanrreed.com").toString(),
	datePublished: published,
	dateModified: modified,
	author,
	mainEntity: {
		"@type": "WebSite",
		"@id": "https://rngchords.jonathanrreed.com/#website",
		name: "RNG Chords",
		description,
		isAccessibleForFree: true,
		url: "https://rngchords.jonathanrreed.com/",
		creator: author,
	},
};
---

<InfoPage
	title={title}
	description={description}
	path="/about/"
	heading="Random chords for getting unstuck"
	jsonLd={[structuredData]}
	dateLabel="Published"
	date={published}
>
	<p>
		RNG Chords is a free chord progression generator that runs in your browser.
		Roll dice, listen, and keep what you like. It works for any instrument,
		since a chord is the same set of notes wherever you play it.
	</p>
	<p>
		Some rolls are wrong in a useful way. Hearing a chord you'd never have
		written often tells you what you wanted in that slot. It also works as a
		practice prompt: reroll until you land in a key you rarely play in, then
		work the progression out by ear.
	</p>
</InfoPage>
