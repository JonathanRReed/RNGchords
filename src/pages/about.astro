---
import InfoPage from "../layouts/InfoPage.astro";

const title = "About RNG Chords | Jonathan R. Reed";
const description =
	"RNG Chords is a free browser-based chord progression generator by Jonathan R. Reed for songwriting, guitar, piano, and MIDI idea sketching.";
const published = "2026-04-21";
const modified = "2026-08-04";
const author = {
	"@type": "Person",
	name: "Jonathan R. Reed",
	url: "https://jonathanrreed.com",
};
const structuredData = {
	"@context": "https://schema.org",
	"@type": "AboutPage",
	name: "About RNG Chords",
	description,
	url: new URL("/about/", Astro.site ?? "https://rngchords.jonathanrreed.com").toString(),
	datePublished: published,
	dateModified: modified,
	author,
	mainEntity: {
		"@type": "WebSite",
		"@id": "https://rngchords.jonathanrreed.com/#website",
		name: "RNG Chords",
		description,
		isAccessibleForFree: true,
		url: "https://rngchords.jonathanrreed.com/",
		creator: author,
	},
};
---

<InfoPage
	title={title}
	description={description}
	path="/about/"
	heading="Random chords for getting unstuck"
	jsonLd={[structuredData]}
	dateLabel="Published"
	date={published}
>
	<p>
		RNG Chords is a free chord progression generator that runs in your browser.
		I built it for guitarists, pianists, songwriters, and producers who want a
		progression in front of them before they have a plan for it.
	</p>
	<p>
		Starting is hard when there's nothing to react to. A random roll fixes
		that. Some rolls are wrong in a useful way: hearing a chord you'd never have
		written often tells you what you wanted in that slot. Taste is still your
		job. This just gets you to the part where you have opinions.
	</p>
	<p>
		It works as a practice prompt too. Reroll until you land in a key you
		rarely play in, work out the progression by ear, transpose it, or export
		the MIDI and read it back in a DAW or notation program.
	</p>
	<p>
		I kept the scope small on purpose, so it stays a tab you can open between
		other work. If a roll mattered, export it before you close the page.
	</p>
</InfoPage>
