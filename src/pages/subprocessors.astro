---
import InfoPage from "../layouts/InfoPage.astro";

const title = "RNG Chords Subprocessor Disclosure";
const description =
	"Subprocessor disclosure for RNG Chords, including Cloudflare Pages hosting and browser-local chord generation.";
const published = "2026-06-19";
const structuredData = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	name: "RNG Chords Subprocessor Disclosure",
	description,
	url: new URL("/subprocessors/", Astro.site ?? "https://rngchords.jonathanrreed.com").toString(),
	datePublished: published,
	dateModified: published,
	author: {
		"@type": "Person",
		name: "Jonathan R. Reed",
		url: "https://jonathanrreed.com",
	},
};
---

<InfoPage
	title={title}
	description={description}
	path="/subprocessors/"
	heading="Subprocessors"
	jsonLd={[structuredData]}
	dateLabel="Last updated"
	date={published}
>
	<p>
		RNG Chords is hosted on Cloudflare Pages. Cloudflare may process routine
		request data, such as IP address, user agent, request time, and security
		signals, to deliver and protect the site.
	</p>
	<p>
		The chord generator runs in your browser. It creates no accounts, stores no
		progressions in a database, and sends no chord ideas to a hosted music
		service. Fonts and images are served from the same site.
	</p>
	<p>
		MIDI export is generated in the page. Once you save or share a file, it's
		controlled by the device, DAW, notes app, or storage service you chose.
	</p>
	<p>
		If RNG Chords ever adds accounts, sync, analytics, collaboration, or hosted
		libraries, this page will be updated before those services get production
		traffic.
	</p>
	<p>
		For questions about data handling, use the <a href="/contact/">contact page</a>.
	</p>
</InfoPage>
